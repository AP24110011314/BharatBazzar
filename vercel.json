{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "public": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://bharatbazzar-backend.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}

