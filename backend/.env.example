# ========================================================
# BharatBazzar Backend Environment Configuration
# ========================================================

# MongoDB Atlas Cloud Database Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
DB_NAME=shopdb

# Server Port (Render sets this dynamically, defaults to 5001 locally)
PORT=5001

# Allowed CORS Origins (Use * for all, or comma-separated Vercel domains)
CLIENT_URL=*

# JSON Web Token Secret and Expiry
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Payment Gateway Configuration (Razorpay / Mock)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
CURRENCY=INR
PAYMENT_HOLD_MINUTES=15
